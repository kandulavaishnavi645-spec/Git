#include <iostream>
using namespace std;

class Rectangle
{
    int length, breadth;

public:
    void accept()
    {
        cout << "Enter length and breadth: ";
        cin >> length >> breadth;
    }

    int area();
    int perimeter()
    {
        return 2 * (length + breadth);
    }
};

int Rectangle::area()
{
    return length * breadth;
}

int main()
{
    Rectangle r;
    r.accept();

    cout << "Area = " << r.area() << endl;
    cout << "Perimeter = " << r.perimeter();

    return 0;
}
