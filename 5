#include <iostream>
using namespace std;

class Employee
{
    float salary;

public:
    Employee()
    {
        salary = 10000;
    }

    Employee(float s)
    {
        salary = s;
    }

    void display()
    {
        cout << "Basic Salary = " << salary;
        cout << "\nTotal Salary = " << salary + 2000 << endl;
    }
};

int main()
{
    Employee e1;
    Employee e2(25000);

    e1.display();
    e2.display();

    return 0;
}
