#include <iostream>
using namespace std;

class Book
{
    int price;

public:
    Book(int p)
    {
        price = p;
    }

    Book(const Book &b)
    {
        price = b.price;
    }

    void display()
    {
        cout << "Price = " << price << endl;
    }

    ~Book()
    {
        cout << "Destructor called" << endl;
    }
};

int main()
{
    Book b1(500);
    Book b2(b1);

    cout << "Original Book: ";
    b1.display();

    cout << "Copied Book: ";
    b2.display();

    return 0;
}
